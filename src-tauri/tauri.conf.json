{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaggotClaw Games",
  "version": "1.15.0-beta",
  "identifier": "com.maggotclaw.games",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:dictation && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaggotClaw Games",
        "width": 1120,
        "height": 820,
        "minWidth": 180,
        "minHeight": 60,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/WindowsDictation.exe",
      "resources/NAudio.dll",
      "resources/Vosk.dll",
      "resources/libvosk.dll",
      "resources/libgcc_s_seh-1.dll",
      "resources/libstdc++-6.dll",
      "resources/libwinpthread-1.dll",
      "resources/vosk-model/**/*",
      "resources/piper/**/*"
    ],
    "shortDescription": "The reader, voice, project, and collaboration hub for MaggotClaw Games",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
