{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaggotClaw Games Reader",
  "version": "0.4.0",
  "identifier": "com.maggotclaw.thelongrot.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:dictation && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaggotClaw Games Reader",
        "width": 1120,
        "height": 820,
        "minWidth": 180,
        "minHeight": 60,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/WindowsDictation.exe"],
    "shortDescription": "Reader, feedback, and voice companion for MaggotClaw Games",
    "category": "Productivity"
  }
}
