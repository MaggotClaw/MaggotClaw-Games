{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Long Rot Reader",
  "version": "0.1.0",
  "identifier": "com.maggotclaw.thelongrot.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Long Rot Reader",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Reader and spoken feedback application for The Long Rot",
    "category": "Productivity"
  }
}

