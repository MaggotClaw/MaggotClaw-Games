{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader-window",
  "description": "Permissions for every window the app opens — the hub, the voice bar, the OK GO button, the guide, and the chapter and file windows.",
  "windows": ["main", "companion", "discord", "okgo", "walkthrough", "doc-*", "file-*"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-resizable",
    "core:window:allow-set-shadow",
    "core:window:allow-start-dragging",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
